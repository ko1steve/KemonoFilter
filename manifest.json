{
  "name": "KemonoFilter",
  "action": {},
  "manifest_version": 3,
  "version": "1.0.0",
  "description": "",
  "content_scripts": [
    {
      "css": [
        "src/component/search/style.css"
      ],
      "js": [
        "src/component/search/content.js"
      ],
      "matches": [
        "https://kemono.cr/posts*",
        "https://kemono.su/posts*",
        "https://kemono.cr/*/user/*",
        "https://kemono.su/*/user/*"
      ]
    },
    {
      "css": [
        "src/component/artist/style.css"
      ],
      "js": [
        "src/component/artist/content.js"
      ],
      "matches": [
        "https://kemono.cr/*/user/*/recommended",
        "https://kemono.su/*/user/*/recommended"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "image/checkbox_across_enabled.png",
        "image/checkbox_across_disabled.png",
        "image/checkbox_tick_enabled.png",
        "image/checkbox_tick_disabled.png"
      ],
      "matches": [
        "https://kemono.cr/*",
        "https://kemono.su/*"
      ]
    }
  ],
  "host_permissions": [
    "https://kemono.cr/*",
    "https://kemono.su/*"
  ]
}